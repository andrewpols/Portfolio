{
    "headers": [
        {
            "source": "/download/AndrewPolsResume.pdf",
            "headers": [
                { "key": "Content-Type", "value": "application/octet-stream" },
                { "key": "Content-Disposition", "value": "attachment; filename=\"AndrewPolsResume.pdf\"" },
                { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/download/AndrewPolsResume.pdf",
            "destination": "/AndrewPolsResume.pdf"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
